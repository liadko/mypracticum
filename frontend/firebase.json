{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json","**/.*","**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/v1/**",
        "run": {
          "serviceId": "go-app",      
          "region":    "me-west1"           
        }
      },
      {
        "source": "**", 
        "destination": "/index.html"           
      }
    ]
  }
}
