# Dockerfile.alpine
FROM node:20-alpine

# If you still need musl→glibc compat for other modules
RUN apk add --no-cache libc6-compat

WORKDIR /app

# 1) Copy only package.json
COPY package.json ./

# 2) Fresh install (will pull in @rollup/rollup-linux-x64-musl)
RUN npm install

# 3) Now copy the rest of your code
COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev"]
